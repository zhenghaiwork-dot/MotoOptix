---
import type { ProductPlatform } from '../lib/products';
interface Props { product: ProductPlatform }
const { product } = Astro.props;
---
<article class="product-card">
  <div class="product-visual" aria-hidden="true">
    <img src={`/product-images/${product.id}.webp`} alt="" width="800" height="800" loading="lazy" decoding="async" />
    <small>{product.code}</small>
  </div>
  <div class="product-copy">
    <div class="eyebrow-row"><span>{product.type}</span><span class="evidence-chip">SOURCE CAPTURED</span></div>
    <h3>{product.name}</h3>
    <p>{product.summary}</p>
    <ul>{product.highlights.map(item => <li>{item}</li>)}</ul>
    <a class="text-link" href={`/products/${product.id}/`}>Review configuration <span>→</span></a>
  </div>
</article>
