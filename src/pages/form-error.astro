---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Buying Brief Could Not Be Sent" description="Alternative contact options when the MotoOptix buying brief form cannot be delivered." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Form delivery issue', url: '/form-error/' }]}>
  <section class="simple-hero"><p class="kicker dark"><span></span> Delivery issue</p><h1>Your buying brief was not confirmed.</h1><p>Please keep this page open and try again, or email the same details directly to <a href={`mailto:${site.email}`}>{site.email}</a>. Include your target market, expected quantity and must-have requirements.</p><div class="button-row"><a class="button" href="/contact/">Return to the form →</a><a class="text-link" href={`mailto:${site.email}`}>Email MotoOptix →</a></div></section>
</BaseLayout>
