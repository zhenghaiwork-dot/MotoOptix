---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProducts } from '../lib/products';
import { collectionPageSchema } from '../lib/schema';
const base = Astro.site?.href || Astro.url.origin;
const products = await getProducts();
---
<BaseLayout title="Motorcycle Camera Product Platforms" description="Compare MotoOptix wholesale motorcycle DVR and smart display platforms for distributors and installers." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Products', url: '/products/' }]}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionPageSchema([{ name: 'Home', url: '/' }, { name: 'Products', url: '/products/' }], base, products.map(p => ({ name: p.name, url: `/products/${p.id}/`, description: p.summary }))))}></script>
  <section class="page-hero"><p class="kicker dark"><span></span> A focused range, configured for your market</p><h1>Wholesale Motorcycle Dash Cam<br /><em>& Smart Display Platforms.</em></h1><p>These are sourcing platforms, not invented fixed models. Available components and specifications are confirmed against your sample and order.</p></section>
  <section class="product-catalog" data-product-catalog>
    <div class="product-filters" aria-label="Filter product platforms">
      <div class="filter-topline"><div><strong>Find a product platform</strong><span data-result-count>{products.length} products</span></div><label><span class="sr-only">Search products</span><input type="search" placeholder="Search product, feature or code" data-product-search /></label><button type="button" data-filter-reset>Reset filters</button></div>
      <div class="filter-row" data-filter-group="category"><b>Product type</b><button type="button" class="is-active" data-filter="all">All</button><button type="button" data-filter="dvr">Installed DVR</button><button type="button" data-filter="display">Smart display</button><button type="button" data-filter="camera">Portable camera</button><button type="button" data-filter="helmet">Helmet camera</button></div>
      <div class="filter-row" data-filter-group="channels"><b>Camera setup</b><button type="button" class="is-active" data-filter="all">All</button><button type="button" data-filter="single">Single camera</button><button type="button" data-filter="dual">Front + rear</button><button type="button" data-filter="display-only">Display only</button></div>
      <div class="filter-row" data-filter-group="power"><b>Power format</b><button type="button" class="is-active" data-filter="all">All</button><button type="button" data-filter="hardwired">Hardwired / ACC</button><button type="button" data-filter="usb">USB powered</button><button type="button" data-filter="battery">Battery powered</button></div>
      <div class="filter-row" data-filter-group="feature"><b>Key feature</b><button type="button" class="is-active" data-filter="all">All</button><button type="button" data-filter="wifi">Wi-Fi</button><button type="button" data-filter="gps">GPS</button><button type="button" data-filter="carplay">CarPlay</button><button type="button" data-filter="tpms">TPMS</button></div>
    </div>
    <div class="catalog-toolbar"><p><b>Product platforms</b><span>Supplier-listed data · verify selected samples before quotation</span></p><span>Compare configurations on each product page</span></div>
    <div class="catalog-grid">
      {products.map((p) => {
        return <article id={p.id} class="catalog-card" data-product-item data-category={p.category} data-channels={p.channels} data-power={p.powerFormat} data-features={p.features.join(' ')} data-search={`${p.name} ${p.code} ${p.type} ${p.highlights.join(' ')}`.toLowerCase()}>
          <a class="catalog-card-visual" href={`/products/${p.id}/`} aria-label={`View ${p.name}`}><img src={`/product-images/${p.id}.webp`} alt={p.name} width="800" height="800" loading="lazy" decoding="async" /><span>{p.code}</span><small>{p.category === 'display' ? 'SMART COCKPIT' : p.category === 'helmet' ? 'WEARABLE CAMERA' : 'RECORDING SYSTEM'}</small></a>
          <div class="catalog-card-body"><div class="catalog-card-tags"><span>{p.type}</span><span>{p.evidenceStage.replace('-', ' ')}</span></div><h2><a href={`/products/${p.id}/`}>{p.name}</a></h2><p>{p.summary}</p><ul>{p.highlights.slice(0, 3).map(x => <li>{x}</li>)}</ul><div class="catalog-card-footer"><span>{p.configurations.length} configuration{p.configurations.length === 1 ? '' : 's'}</span><div><a href={`/contact/?product=${p.id}`}>Quick RFQ</a><a href={`/products/${p.id}/`}>View product <b>↗</b></a></div></div></div>
        </article>;
      })}
    </div>
    <div class="catalog-empty" hidden data-catalog-empty><h2>No matching platforms</h2><p>Try removing one filter or send us your requirement for a focused shortlist.</p><button type="button" data-filter-reset>Clear all filters</button></div>
  </section>
  <script is:inline>
    const catalog = document.querySelector('[data-product-catalog]');
    if (catalog) {
      const state = { category: 'all', channels: 'all', power: 'all', feature: 'all', search: '' };
      const items = [...catalog.querySelectorAll('[data-product-item]')];
      const count = catalog.querySelector('[data-result-count]');
      const empty = catalog.querySelector('[data-catalog-empty]');
      const apply = () => {
        let visible = 0;
        items.forEach((item) => {
          const matches = (state.category === 'all' || item.dataset.category === state.category) && (state.channels === 'all' || item.dataset.channels === state.channels) && (state.power === 'all' || item.dataset.power === state.power) && (state.feature === 'all' || item.dataset.features.split(' ').includes(state.feature)) && (!state.search || item.dataset.search.includes(state.search));
          item.hidden = !matches;
          if (matches) visible += 1;
        });
        count.textContent = `${visible} product${visible === 1 ? '' : 's'}`;
        empty.hidden = visible !== 0;
      };
      catalog.querySelectorAll('[data-filter-group]').forEach((group) => group.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => {
        group.querySelectorAll('[data-filter]').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        state[group.dataset.filterGroup] = button.dataset.filter;
        apply();
      })));
      catalog.querySelector('[data-product-search]')?.addEventListener('input', (event) => { state.search = event.target.value.trim().toLowerCase(); apply(); });
      catalog.querySelectorAll('[data-filter-reset]').forEach((button) => button.addEventListener('click', () => {
        Object.assign(state, { category: 'all', channels: 'all', power: 'all', feature: 'all', search: '' });
        catalog.querySelector('[data-product-search]').value = '';
        catalog.querySelectorAll('[data-filter-group]').forEach((group) => group.querySelectorAll('[data-filter]').forEach((item) => item.classList.toggle('is-active', item.dataset.filter === 'all')));
        apply();
      }));
    }
  </script>
</BaseLayout>
