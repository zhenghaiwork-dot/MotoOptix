---
import BaseLayout from '../layouts/BaseLayout.astro';
import { requirements } from '../data/site';
import { collectionPageSchema } from '../lib/schema';
const base = Astro.site?.href || Astro.url.origin;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Requirements', url: '/requirements/' }];
---
<BaseLayout title="Motorcycle Camera Requirements" description="Evaluate waterproofing, hardwired power, sunlight readability, vibration resistance and footage retrieval before ordering motorcycle electronics." breadcrumbs={crumbs}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionPageSchema(crumbs, base, requirements.map(item => ({ name: item.title, url: `/requirements/${item.id}/`, description: item.summary }))))}></script>
  <section class="page-hero"><p class="kicker dark"><span></span> Turn claims into buying questions</p><h1>Motorcycle Camera Technical Requirements<br /><em>& Verification Guides.</em></h1><p>These guides help buyers frame evidence requests before a supplier promise becomes a product claim.</p></section>
  <section class="solution-list">{requirements.map((item, i) => <article><span>0{i + 1}</span><div><small>{item.eyebrow}</small><h2>{item.title}</h2></div><ul>{item.verification.map(value => <li>{value}</li>)}</ul><a href={`/requirements/${item.id}/`}>Review requirement ↗</a></article>)}</section>
</BaseLayout>
