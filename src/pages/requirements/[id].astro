---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import { requirements, solutions } from '../../data/site';
import { getProducts } from '../../lib/products';
export function getStaticPaths() { return requirements.map(item => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
const products = await getProducts();
const relatedProducts = products.filter(product => item.recommendedProducts.includes(product.id));
const relatedSolutions = solutions.filter(solution => item.relatedSolutions.includes(solution.id));
const seoTitle = item.id === 'motorcycle-camera-storage-and-footage-retrieval' ? 'Motorcycle Camera Storage & Footage Retrieval' : item.title;
---
<BaseLayout title={seoTitle} description={item.summary} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Requirements', url: '/requirements/' }, { name: item.title, url: `/requirements/${item.id}/` }]}>
  <section class="solution-hero"><div><a class="back-link" href="/requirements/">← All requirements</a><p class="kicker dark"><span></span> {item.eyebrow}</p><h1>{item.title}</h1><p>{item.summary}</p><a class="button" href={`/contact/?requirement=${item.id}`}>{item.cta} ↗</a></div><aside><small>WHY THIS MATTERS</small><p>{item.problem}</p></aside></section>
  <section class="solution-columns"><div><small>BUYING QUESTIONS</small><ol>{item.priorities.map((value, i) => <li><span>0{i + 1}</span>{value}</li>)}</ol></div><div><small>VERIFICATION CHECKS</small><ol>{item.verification.map((value, i) => <li><span>0{i + 1}</span>{value}</li>)}</ol></div></section>
  <section class="recommended"><div><p class="kicker dark"><span></span> Related paths</p><h2>Connect the requirement to product and operating context.</h2><p>Only publish performance claims after the selected sample, supplier revision and available documents support them.</p></div><div>{relatedProducts.map(product => <a href={`/products/${product.id}/`}><small>PRODUCT · {product.code}</small><h3>{product.name}</h3><span>Review platform →</span></a>)}{relatedSolutions.map(solution => <a href={`/solutions/${solution.id}/`}><small>SOLUTION · {solution.eyebrow}</small><h3>{solution.title}</h3><span>Review buying path →</span></a>)}</div></section>
  <RelatedResources requirementId={item.id} />
</BaseLayout>
