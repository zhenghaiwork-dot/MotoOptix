---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import { supportTopics, solutions } from '../../data/site';
import { getProducts, resolveProductReferences } from '../../lib/products';
export function getStaticPaths() { return supportTopics.map(item => ({ params: { id: item.id }, props: { item } })); }
const { item } = Astro.props;
const products = await getProducts();
const relatedProductIds = resolveProductReferences(item.recommendedProducts);
const relatedProducts = products.filter(product => relatedProductIds.includes(product.id));
const relatedSolutions = solutions.filter(solution => item.relatedSolutions.includes(solution.id));
const seoTitles: Record<string, string> = {
  'request-spec-sheet-and-sample': 'Motorcycle Camera Spec Sheets & Samples',
  'installation-and-after-sales-planning': 'Installation & After-Sales Planning',
  'compliance-document-verification': 'Compliance Document Verification',
  'private-label-artwork-and-boot-logo': 'Private-Label Artwork & Boot Logos',
  'spare-parts-and-replacement-planning': 'Spare Parts & Replacement Planning',
};
const seoTitle = seoTitles[item.id] || item.title;
---
<BaseLayout title={seoTitle} description={item.summary} breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Support', url: '/support/' }, { name: item.title, url: `/support/${item.id}/` }]}>
  <section class="solution-hero"><div><a class="back-link" href="/support/">← All buyer support</a><p class="kicker dark"><span></span> {item.eyebrow}</p><h1>{item.title}</h1><p>{item.summary}</p><a class="button" href={`/contact/?support=${item.id}`}>{item.cta} ↗</a></div><aside><small>THE SUPPORT GAP</small><p>{item.problem}</p></aside></section>
  <section class="solution-columns"><div><small>PREPARE</small><ol>{item.priorities.map((value, i) => <li><span>0{i + 1}</span>{value}</li>)}</ol></div><div><small>CHECK BEFORE APPROVAL</small><ol>{item.verification.map((value, i) => <li><span>0{i + 1}</span>{value}</li>)}</ol></div></section>
  <section class="recommended"><div><p class="kicker dark"><span></span> Related paths</p><h2>Use support to protect the commercial decision.</h2><p>These pages are planning tools. Final commercial commitments should reference the exact quoted configuration.</p></div><div>{relatedProducts.map(product => <a href={`/products/${product.id}/`}><small>PRODUCT · {product.code}</small><h3>{product.name}</h3><span>Review platform →</span></a>)}{relatedSolutions.map(solution => <a href={`/solutions/${solution.id}/`}><small>SOLUTION · {solution.eyebrow}</small><h3>{solution.title}</h3><span>Review buying path →</span></a>)}</div></section>
  <RelatedResources supportId={item.id} />
</BaseLayout>
